# Postgres connection string (from Neon). Without it the app keeps data in memory (local testing only).
DATABASE_URL=
# Long random secret that goes inside the Claude connector link. Treat it like a password.
MCP_TOKEN=
# Login for the web app (defaults shown).
APP_USERNAME=demo
APP_PASSWORD=clear45-demo
# Set to 1 to show the demo login on the sign-in page.
SHOW_DEMO_LOGIN=1
